{
  "name": "usdm-ts",
  "version": "0.11.0",
  "type": "module",
  "description": "A Typescript library that provides a structured representation of the USDM (Unified Study Data Model) for clinical trials.",
  "scripts": {
    "references": "test -f scripts/setup-references.sh && bash scripts/setup-references.sh || true",
    "build": "tsx scripts/build.ts",
    "generate": "tsx src/generate.ts",
    "generate-docs": "tsx scripts/generate-docs.ts",
    "schema": "python3 scripts/extract-usdm-schema.py",
    "update-codelists": "python3 scripts/update-codelists-from-sdtmct.py",
    "lint": "eslint .",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm build && pnpm generate-docs",
    "release": "tsx scripts/release.ts",
    "release:dry-run": "tsx scripts/release.ts --dry-run"
  },
  "keywords": [
    "usdm",
    "clinical-trials",
    "cdisc",
    "ddf"
  ],
  "author": "HumanTrue Inc.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "pnpm": ">=10.12.1",
    "npm": "please-use-pnpm"
  },
  "files": [
    "dist/",
    "src/",
    "scripts/",
    "tsconfig.json"
  ],
  "exports": {
    "./types": {
      "types": "./dist/generated/types/index.d.ts",
      "default": "./dist/generated/types/index.js"
    },
    "./zod": {
      "types": "./dist/generated/zod.d.ts",
      "default": "./dist/generated/zod.js"
    },
    "./usdm-schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./codelists": {
      "types": "./dist/codelists.d.ts",
      "default": "./dist/codelists.js"
    }
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "fast-xml-parser": "^5.12.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-config-love": "^158.0.0",
    "eslint-config-next": "16.4.6",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "typescript-eslint": "^8.73.0"
  }
}
